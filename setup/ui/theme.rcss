/* Otogi XUnchain launcher. The original Xbox's green (#107C10, the dashboard's
   lime glow #9BF00B) for the chrome; Otogi's own art, crimson, gold and washi
   cream for the game. RmlUi has no default styles: every element used is here. */

@spritesheet title {
	src: art/title.jpg;
	band: 0px 25px 1024px 385px;
}
@spritesheet raikoh {
	src: art/raikoh.jpg;
	raikoh: 30px 60px 610px 430px;
}
@spritesheet brush {
	src: art/brush.png;
	brush: 0px 6px 215px 52px;
}

div, p, h1, h2, h3, h4, section, header, nav { display: block; }
strong { font-weight: bold; }

body {
	width: 100%;
	height: 100%;
	margin: 0;
	display: flex;
	flex-direction: column;
	font-family: "Segoe UI";
	font-size: 15dp;
	color: #e6eee0;
	background-color: #060905;
}

/* ── Title bar: drag it to move the window ─────────────────────────────── */
#titlebar {
	height: 40dp;
	flex: 0 0 40dp;
	display: flex;
	align-items: center;
	padding-left: 16dp;
	background-color: #040603;
	border-bottom: 1dp #16260f;
}
#titlebar .mark {
	font-family: "Shippori Mincho B1";
	font-size: 18dp;
	color: #9bf00b;
	margin-right: 10dp;
}
#titlebar .name { font-size: 12dp; letter-spacing: 3dp; color: #b9c8b0; font-weight: bold; }
#titlebar .ver { font-size: 12dp; color: #5c6f52; margin-left: 10dp; }
#titlebar .grow { flex: 1; }
.winbtn {
	width: 46dp;
	height: 40dp;
	line-height: 40dp;
	text-align: center;
	font-family: "Segoe MDL2 Assets";
	font-size: 10dp;
	color: #a8b6a0;
	transition: background-color 0.12s linear-in-out;
}
.winbtn:hover { background-color: #ffffff14; color: #fff; }
.winbtn.close:hover { background-color: #c42b1c; }

#main { position: relative; flex: 1; display: flex; flex-direction: row; min-height: 0; }

/* ── Sidebar ───────────────────────────────────────────────────────────── */
#sidebar {
	width: 232dp;
	flex: 0 0 232dp;
	display: flex;
	flex-direction: column;
	padding-top: 14dp;
	background-color: #070b06;
	border-right: 1dp #15240f;
}
.navitem {
	display: flex;
	align-items: center;
	height: 46dp;
	margin: 2dp 10dp;
	padding-left: 14dp;
	border-radius: 4dp;
	color: #a9b8a1;
	font-size: 15dp;
	tab-index: auto;
	nav: vertical;
	transition: background-color color 0.15s cubic-out;
}
.navitem .icon {
	font-family: "Segoe MDL2 Assets";
	font-size: 17dp;
	width: 32dp;
}
.navitem:hover { background-color: #ffffff0a; color: #e6eee0; }
.navitem:focus-visible { box-shadow: #9bf00b 0 0 0 2dp; }
.navitem.on {
	color: #ffffff;
	background-color: #107c1026;
	border-left: 2dp #9bf00b;
	padding-left: 12dp;
}
.navitem.on .icon { color: #9bf00b; }
.navitem .badge {
	margin-left: 8dp;
	padding: 1dp 7dp;
	border-radius: 3dp;
	font-size: 11dp;
	font-weight: bold;
	color: #061004;
	background-color: #9bf00b;
	display: none;
}
.navitem .badge.shown { display: block; }
#sidebar .grow { flex: 1; }
#sidebar .foot { padding: 14dp 22dp 18dp; font-size: 11dp; color: #536348; }
#sidebar .foot p { margin-top: 3dp; }

/* ── Pages ─────────────────────────────────────────────────────────────── */
#content { flex: 1; position: relative; overflow-y: auto; min-width: 0; }
.page { display: none; padding: 26dp 32dp 32dp; }
.page.shown { display: block; }
.page.full { padding: 0; }
h1 {
	font-family: "Shippori Mincho B1";
	font-size: 30dp;
	color: #f2ead8;
	margin-bottom: 4dp;
}
.lede { color: #8fa086; margin-bottom: 22dp; }
h4 { font-weight: bold; font-size: 13dp; letter-spacing: 1dp; color: #9bf00b; margin: 14dp 0 6dp; }
.muted { color: #8fa086; }
.small { font-size: 12dp; }
.good { color: #8ee05a; }
.bad { color: #ff7b6b; }
.gold { color: #d4a84b; }
.mono { font-family: "Consolas"; font-size: 13dp; }

.card {
	position: relative;
	margin-bottom: 16dp;
	padding: 18dp 20dp;
	border-radius: 6dp;
	background-color: #0d150bcc;
	border: 1dp #1d3215;
}
.card h3 {
	font-family: "Shippori Mincho B1";
	font-size: 19dp;
	color: #d4a84b;
	margin-bottom: 8dp;
}
.row { display: flex; flex-direction: row; align-items: center; }
.row .grow { flex: 1; min-width: 0; }
/* One gap between the things in a row: buttons, fields, chips. */
.row > * + * { margin-left: 8dp; }
.row > .btn { margin-right: 0; }
.flush { margin: 0; }
.cols { display: flex; flex-direction: row; }
.cols .col { flex: 1; min-width: 0; }
.cols .col + .col { margin-left: 16dp; }
/* A column whose card grows to the other column's height (Install's log). */
.col.fill { display: flex; flex-direction: column; }
.col.fill > .card { flex: 1 1 auto; display: flex; flex-direction: column; }
.col.fill #log { flex: 1 1 0; height: auto; min-height: 160dp; }
.gap { height: 10dp; }

/* ── Buttons ───────────────────────────────────────────────────────────── */
.btn {
	display: inline-block;
	box-sizing: border-box;
	height: 36dp;
	line-height: 34dp;
	padding: 0 16dp;
	margin-right: 8dp;
	border-radius: 4dp;
	background-color: #1b2a16;
	border: 1dp #2e4a24;
	color: #e6eee0;
	font-size: 14dp;
	text-align: center;
	tab-index: auto;
	nav: auto;
	transition: background-color border-color 0.15s cubic-out;
}
.btn:hover { background-color: #25391e; border-color: #4f7d3c; }
.btn:focus-visible { box-shadow: #9bf00b 0 0 0 2dp; }
.btn:active { background-color: #107c10; }
.btn.primary { background-color: #107c10; border-color: #2fa52f; color: #fff; }
.btn.primary:hover { background-color: #179217; }
.btn.off { opacity: 0.45; }

/* The big one: flat Xbox green. */
.play {
	display: block;
	width: 240dp;
	height: 48dp;
	line-height: 48dp;
	text-align: center;
	border-radius: 4dp;
	font-size: 16dp;
	font-weight: bold;
	letter-spacing: 2dp;
	color: #ffffff;
	background-color: #107c10;
	tab-index: auto;
	nav: auto;
	transition: background-color 0.15s cubic-out;
}
.play:hover { background-color: #179217; }
.play:active { background-color: #0c660c; }
.play:focus-visible { box-shadow: #9bf00b 0 0 0 2dp; }
.play.busy { background-color: #8a2a22; }
.play.busy:hover { background-color: #9e322a; }
.play.off { background-color: #252d24; color: #8a9684; }
.play.wide { width: auto; font-size: 15dp; }

/* ── Form controls ─────────────────────────────────────────────────────── */
input.text {
	box-sizing: border-box;
	height: 36dp;
	padding: 8dp 10dp;
	border-radius: 4dp;
	background-color: #050804;
	border: 1dp #2a4320;
	color: #e6eee0;
	font-size: 14dp;
	cursor: text;
	tab-index: auto;
	nav: auto;
}
input.text:focus { border-color: #9bf00b; }
input.text:placeholder-shown { color: #5c6f52; }

.toggle {
	position: relative;
	width: 46dp;
	height: 24dp;
	border-radius: 4dp;
	background-color: #24301f;
	border: 1dp #3a5030;
	tab-index: auto;
	nav: auto;
	transition: background-color 0.18s cubic-out;
}
.toggle .knob {
	position: absolute;
	top: 3dp;
	left: 3dp;
	width: 18dp;
	height: 16dp;
	border-radius: 2dp;
	background-color: #b8c4b0;
	transition: left background-color 0.18s cubic-out;
}
.toggle.on { background-color: #107c10; border-color: #3cbf3c; }
.toggle.on .knob { left: 25dp; background-color: #ffffff; }
.toggle:focus-visible { box-shadow: #9bf00b 0 0 0 2dp; }

.chips { display: flex; flex-direction: row; flex-wrap: wrap; }
.chips .chip { margin: 0 6dp 6dp 0; }
.chip {
	box-sizing: border-box;
	height: 30dp;
	line-height: 28dp;
	padding: 0 14dp;
	border-radius: 4dp;
	border: 1dp #2e4a24;
	color: #b9c8b0;
	font-size: 13dp;
	tab-index: auto;
	nav: auto;
	transition: background-color border-color 0.15s cubic-out;
}
.chip:hover { border-color: #5f8f4a; color: #fff; }
.chip.on { background-color: #107c10; border-color: #3cbf3c; color: #fff; }
.chip:focus-visible { box-shadow: #9bf00b 0 0 0 2dp; }
.stepper .btn { width: 36dp; padding: 0; }
.stepper .val { width: 48dp; text-align: center; font-weight: bold; }

/* Settings rows */
.setting { display: flex; flex-direction: row; align-items: center; padding: 14dp 0; border-bottom: 1dp #182813; }
.setting .what { flex: 1; min-width: 0; margin-right: 22dp; }
.setting .label { font-size: 15dp; color: #f0f4ec; }
.setting .help { font-size: 12dp; color: #7f9076; margin-top: 3dp; }
.setting .ctl { flex: 0 0 auto; }
/* Choices and text fields go under their label, toggles beside it. */
.setting.stack { display: block; }
.setting.stack .what { margin: 0 0 10dp; }
.setting input.text { width: 260dp; }
.setting input.custom { margin-top: 4dp; }
.hidden { display: none; }

/* ── Progress ──────────────────────────────────────────────────────────── */
progress {
	display: block;
	width: 100%;
	height: 6dp;
	border-radius: 2dp;
	background-color: #142010;
	margin: 10dp 0 6dp;
}
progress fill { border-radius: 2dp; background-color: #107c10; }
.steps { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 10dp; }
.step { box-sizing: border-box; width: 50%; display: flex; flex-direction: row; align-items: flex-start; padding: 5dp 12dp 5dp 0; color: #6f8066; }
.step .dot { flex: 0 0 auto; width: 8dp; height: 8dp; border-radius: 2dp; border: 2dp #4a5a42; margin: 5dp 12dp 0 0; }
.step.done { color: #dfe8d8; }
.step.done .dot { background-color: #9bf00b; border-color: #9bf00b; }
.step.now { color: #ffffff; }
.step.now .dot { border-color: #9bf00b; animation: 1s pulse infinite alternate; }
.step.now .label { display: inline-block; padding: 3dp 18dp 4dp 10dp; margin-left: -10dp; decorator: image(brush fill); }
.step.failed { color: #ff7b6b; }
.step.failed .dot { background-color: #e0604f; border-color: #e0604f; }
@keyframes pulse { from { opacity: 0.4; } to { opacity: 1; } }

/* ── Log ───────────────────────────────────────────────────────────────── */
.logview, #log {
	height: 420dp;
	overflow: auto;
	padding: 10dp 12dp;
	border-radius: 4dp;
	background-color: #030502;
	border: 1dp #1a2b14;
	font-family: "Consolas";
	font-size: 12dp;
	color: #a9c09c;
	white-space: pre;
}

scrollbarvertical { width: 10dp; margin-left: 2dp; }
scrollbarhorizontal { height: 10dp; }
scrollbarvertical slidertrack, scrollbarhorizontal slidertrack { background-color: #ffffff05; }
scrollbarvertical sliderbar, scrollbarhorizontal sliderbar { background-color: #3d6a2b88; border-radius: 2dp; }
scrollbarvertical sliderbar { min-height: 30dp; }
scrollbarvertical sliderbar:hover, scrollbarhorizontal sliderbar:hover { background-color: #5fa040; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0; }

/* ── Play: the title screen's brocade and logo, Raikoh, spirit lights ──── */
#hero {
	position: relative;
	height: 440dp;
	overflow: hidden;
	background-color: #000;
}
/* The band fades out over Raikoh: his JPEG is opaque black. */
#hero .band { position: absolute; left: 0; top: 0; width: 904dp; height: 340dp; decorator: image(band fill); mask-image: linear-gradient(90deg, #000 52%, #0000 78%); }
#hero .raikoh { position: absolute; right: -10dp; top: 0; width: 600dp; height: 424dp; decorator: image(raikoh contain right center); }
#hero .floor { position: absolute; left: 0; right: 0; bottom: 0; height: 150dp; decorator: linear-gradient(180deg, #06090500, #060905); }
#hero .sub {
	position: absolute; left: 112dp; top: 302dp;
	font-family: "Shippori Mincho B1"; font-size: 20dp; color: #efe6d2;
	font-effect: shadow(1dp 2dp #000);
}
#hero .cta { position: absolute; left: 100dp; top: 346dp; display: flex; flex-direction: row; align-items: center; }
#hero .cta .status { margin-left: 22dp; color: #b9c8b0; font-size: 14dp; }
#hero .cta .status strong { color: #fff; }

.light {
	position: absolute;
	width: 6dp;
	height: 6dp;
	border-radius: 3dp;
	background-color: #b6ff6a;
	box-shadow: #9bf00b99 0 0 12dp 4dp;
	opacity: 0;
}
@keyframes rise {
	0% { transform: translateY(0dp); opacity: 0; }
	15% { opacity: 0.8; }
	70% { opacity: 0.5; }
	100% { transform: translateY(-420dp); opacity: 0; }
}

.tiles { display: flex; flex-direction: row; padding: 0 32dp 16dp; margin-top: 4dp; }
.tile {
	flex: 1;
	position: relative;
	min-width: 0;
	margin-right: 16dp;
	padding: 18dp 20dp;
	border-radius: 6dp;
	background-color: #0d150be6;
	border: 1dp #1d3215;
	tab-index: auto;
	nav: auto;
	transition: border-color background-color 0.15s cubic-out;
}
.tile:last-child { margin-right: 0; }
.tile:hover { border-color: #4f7d3c; background-color: #121d0fee; }
.tile:focus-visible { box-shadow: #9bf00b 0 0 0 2dp; }
.tile .kicker { font-size: 11dp; letter-spacing: 2dp; color: #9bf00b; font-weight: bold; }
.tile .big { font-family: "Shippori Mincho B1"; font-size: 20dp; color: #f2ead8; margin: 6dp 0 4dp; }
.tile .icon { position: absolute; right: 18dp; top: 16dp; font-family: "Segoe MDL2 Assets"; font-size: 20dp; color: #3d6a2b; }

/* ── Saves and releases ────────────────────────────────────────────────── */
.save { display: flex; flex-direction: row; align-items: center; padding: 12dp 4dp; border-bottom: 1dp #182813; }
.save .icon { font-family: "Segoe MDL2 Assets"; font-size: 20dp; color: #9bf00b; width: 40dp; }
.save .name { flex: 1; color: #f0f4ec; }
.save .meta { color: #7f9076; font-size: 12dp; margin-left: 18dp; }
.path { box-sizing: border-box; height: 36dp; line-height: 20dp; overflow: hidden; white-space: nowrap; padding: 8dp 12dp; border-radius: 4dp; background-color: #050804; border: 1dp #1d3215; font-family: "Consolas"; font-size: 13dp; color: #c9d8bf; }

.release h3 { margin-bottom: 2dp; }
.release .when { color: #7f9076; font-size: 12dp; margin-bottom: 6dp; }
.release p { margin: 3dp 0; color: #d0dac9; }
.release p.li { padding-left: 16dp; decorator: radial-gradient(circle 3dp at 5dp 11dp, #9bf00b, #9bf00b 90%, #9bf00b00) padding-box; }
.release .code { font-family: "Consolas"; color: #d4a84b; }
.tag { display: inline-block; padding: 1dp 8dp; margin-left: 10dp; border-radius: 3dp; font-size: 11dp; font-weight: bold; font-family: "Segoe UI"; }
.tag.now { background-color: #2a3a24; color: #b9c8b0; }
.tag.new { background-color: #9bf00b; color: #061004; }

#banner { display: none; }
#banner.shown { display: block; border-color: #107c10; border-left: 3dp #9bf00b; }

#toast {
	position: absolute;
	right: 24dp;
	bottom: 22dp;
	padding: 10dp 18dp;
	border-radius: 4dp;
	background-color: #107c10;
	color: #fff;
	font-size: 13dp;
	box-shadow: #00000066 0 2dp 8dp 0;
	opacity: 0;
	transition: opacity 0.25s cubic-out;
}
#toast.shown { opacity: 1; }

/* ── Help & logs ───────────────────────────────────────────────────────── */
.card.help .icon { position: absolute; right: 20dp; top: 18dp; font-family: "Segoe MDL2 Assets"; font-size: 22dp; color: #3d6a2b; }
#help-log { height: 380dp; }
#help-log-info { margin: 8dp 0; }
/* Equal-height cards (the row stretches them); buttons sit on the bottom edge. */
.card.help { display: flex; flex-direction: column; }
.card.help .actions { margin-top: auto; padding-top: 14dp; }
